# ===== 服务 =====
SERVER_PORT=8080

# ===== 鉴权(JWT 双 Token) =====
JWT_ACCESS_SECRET=please-change-access-secret
JWT_REFRESH_SECRET=please-change-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_ISSUER=wenlv-backend

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wenlv

# ===== Redis =====
REDIS_ADDR=127.0.0.1:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# ===== OSS(图片存储,M4 使用) =====
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=

# ===== AI 行程规划模块(可留空,前端"设置"弹窗里配置后热生效) =====
# LLM(OpenAI 兼容接口,用于景点提纯/行程生成/行程问答)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=
LLM_TIMEOUT=120
TRIP_PLANNER_TIMEOUT=180
# LLM 思考强度:仅"始终思考"的推理模型需要(如智谱 GLM glm-5.3-flash,不设置时长文本生成会返回空内容);
# 可选 low / high / max,留空表示不发送该参数(OpenAI 等不支持该参数的端点请留空)
LLM_THINKING_LEVEL=
# 高德地图 Web 服务 Key(地理编码/POI/天气/路线)
AMAP_WEB_KEY=
# 高德地图 JS API Key(前端地图渲染,仅前端使用)
AMAP_WEB_JS_KEY=
# Google Maps(选填,配置后自动优先使用,失败回退高德)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_PROXY=
# 小红书网页端 Cookie(景点推荐与景点图片数据源)
# 支持配置多个:在前端设置页每行填一个,请求时自动轮换、风控自动切换;环境变量里填单个即可
XHS_COOKIE=
# 抖音网页端 Cookie(景点推荐与景点图片数据源,与小红书二选一/可同时配置)
DOUYIN_COOKIE=
# 用户偏好记忆模块开关
ENABLE_USER_MEMORY=false
# 用户偏好记忆参数
MEMORY_THRESHOLD=2.0
MIN_INIT_WEIGHT=4.0
MEMORY_DECAY_FACTOR=0.97
MEMORY_MAX_RECALL=10
MEMORY_MAX_SINGLE_CONTENT=120
# 行程模块数据目录(任务持久化/图片缓存/运行时配置)
TRIP_DATA_DIR=data
# 景点图片磁盘缓存有效期(小时)与容量上限(MB)
# 缓存存的是图片字节而非时效直链,TTL 越短越频繁触发上游搜图,越容易被平台风控
TRIP_IMAGE_CACHE_TTL_HOURS=168
TRIP_IMAGE_CACHE_MAX_MB=512
# 景点详情页实时数据(周边推荐/交通站点)的 Redis 缓存小时数
SCENIC_CACHE_TTL_HOURS=24
# 小红书签名 JS 目录(需 Node.js 运行时)
TRIP_XHS_SIGN_DIR=xhs_sign
# 抖音签名 JS 目录(需 Node.js 运行时,放置 a_bogus 签名脚本)
TRIP_DOUYIN_SIGN_DIR=douyin_sign
# Wikimedia Commons 取图代理(国内通常需要;留空则尝试直连/标准环境变量)
COMMONS_PROXY=