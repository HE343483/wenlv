# ===== 服务 =====
SERVER_PORT=8080

# ===== 鉴权(JWT 双 Token) =====
JWT_ACCESS_SECRET=please-change-access-secret
JWT_REFRESH_SECRET=please-change-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_ISSUER=wenlv-backend

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wenlv

# ===== Redis =====
REDIS_ADDR=127.0.0.1:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# ===== OSS(图片存储,M4 使用) =====
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=

# ===== AI 行程规划模块(可留空,前端"设置"弹窗里配置后热生效) =====
# LLM(OpenAI 兼容接口,用于景点提纯/行程生成/行程问答)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=
LLM_TIMEOUT=120
TRIP_PLANNER_TIMEOUT=180
# 高德地图 Web 服务 Key(地理编码/POI/天气/路线)
AMAP_WEB_KEY=
# 高德地图 JS API Key(前端地图渲染,仅前端使用)
AMAP_WEB_JS_KEY=
# Google Maps(选填,配置后自动优先使用,失败回退高德)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_PROXY=
# 小红书网页端 Cookie(景点推荐与景点图片数据源)
XHS_COOKIE=
# 用户偏好记忆模块开关
ENABLE_USER_MEMORY=false
# 用户偏好记忆参数
MEMORY_THRESHOLD=2.0
MIN_INIT_WEIGHT=4.0
MEMORY_DECAY_FACTOR=0.97
MEMORY_MAX_RECALL=10
MEMORY_MAX_SINGLE_CONTENT=120
# 行程模块数据目录(任务持久化/图片缓存/运行时配置)
TRIP_DATA_DIR=data
# 小红书签名 JS 目录(需 Node.js 运行时)
TRIP_XHS_SIGN_DIR=xhs_sign